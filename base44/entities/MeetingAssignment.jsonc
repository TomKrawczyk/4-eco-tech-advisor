{
  "name": "MeetingAssignment",
  "type": "object",
  "properties": {
    "meeting_key": {
      "type": "string",
      "description": "Unikalny klucz spotkania (sheet + client_name + meeting_calendar)"
    },
    "sheet": {
      "type": "string",
      "description": "Zak\u0142adka arkusza"
    },
    "client_name": {
      "type": "string",
      "description": "Imi\u0119 i nazwisko klienta"
    },
    "client_phone": {
      "type": "string",
      "description": "Telefon klienta"
    },
    "client_address": {
      "type": "string",
      "description": "Adres klienta"
    },
    "meeting_calendar": {
      "type": "string",
      "description": "Data i godzina spotkania z arkusza"
    },
    "agent": {
      "type": "string",
      "description": "Agent/handlowiec z arkusza"
    },
    "comments": {
      "type": "string",
      "description": "Komentarze/uwagi z arkusza"
    },
    "interview_data": {
      "type": "object",
      "description": "Pytania i odpowiedzi z wywiadu (z arkusza)"
    },
    "assigned_user_email": {
      "type": "string",
      "description": "Email handlowca przypisanego do spotkania"
    },
    "assigned_user_name": {
      "type": "string",
      "description": "Imi\u0119 handlowca (cache)"
    },
    "assigned_group_id": {
      "type": "string",
      "description": "ID grupy przypisanej do spotkania"
    },
    "assigned_group_name": {
      "type": "string",
      "description": "Nazwa grupy (cache)"
    },
    "meeting_date": {
      "type": "string",
      "description": "Data spotkania (YYYY-MM-DD) do filtrowania"
    },
    "notes": {
      "type": "string",
      "description": "Notatki do przypisania"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Czy spotkanie jest ukryte/zarchiwizowane (np. po rezygnacji)"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "Kiedy spotkanie zosta\u0142o zarchiwizowane"
    },
    "archived_by_email": {
      "type": "string",
      "description": "Email osoby, kt\u00f3ra zarchiwizowa\u0142a spotkanie"
    },
    "archived_by_name": {
      "type": "string",
      "description": "Imi\u0119 osoby, kt\u00f3ra zarchiwizowa\u0142a spotkanie"
    },
    "resignation_reason": {
      "type": "string",
      "description": "Pow\u00f3d rezygnacji ze spotkania (z modu\u0142u Gie\u0142da)"
    },
    "resignation_at": {
      "type": "string",
      "format": "date-time",
      "description": "Kiedy zarezygnowano ze spotkania"
    },
    "released_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista emaili handlowc\u00f3w, kt\u00f3rzy oddali to spotkanie na gie\u0142d\u0119 (Nie podejmuj\u0119)"
    },
    "released_at": {
      "type": "string",
      "format": "date-time",
      "description": "Kiedy spotkanie zosta\u0142o ostatnio oddane na gie\u0142d\u0119"
    },
    "released_reason": {
      "type": "string",
      "description": "Pow\u00f3d oddania spotkania na gie\u0142d\u0119 (informacyjny)"
    }
  },
  "required": [
    "meeting_key",
    "sheet",
    "client_name"
  ]
}