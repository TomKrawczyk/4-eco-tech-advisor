{
  "name": "ContactPackage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nazwa paczki kontakt\u00f3w"
    },
    "description": {
      "type": "string",
      "description": "Opis paczki"
    },
    "group_id": {
      "type": "string",
      "description": "ID grupy w\u0142a\u015bciciela paczki (puste dla paczek prywatnych)"
    },
    "group_name": {
      "type": "string",
      "description": "Nazwa grupy (cache)"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "Paczka prywatna \u2014 przypisana bezpo\u015brednio do handlowca, niewidoczna dla lider\u00f3w grup"
    },
    "assigned_user_email": {
      "type": "string",
      "description": "Email pierwszego handlowca do kt\u00f3rego przypisana jest paczka prywatna"
    },
    "assigned_user_name": {
      "type": "string",
      "description": "Imiona handlowc\u00f3w (cache, np. 'Jan Kowalski, Adam Nowak')"
    },
    "assigned_user_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista emaili handlowc\u00f3w przypisanych do paczki prywatnej (max 2)"
    },
    "created_by_email": {
      "type": "string",
      "description": "Email lidera kt\u00f3ry stworzy\u0142 paczk\u0119"
    },
    "created_by_name": {
      "type": "string",
      "description": "Imi\u0119 lidera (cache)"
    },
    "total_count": {
      "type": "number",
      "default": 0,
      "description": "\u0141\u0105czna liczba kontakt\u00f3w w paczce"
    },
    "assigned_count": {
      "type": "number",
      "default": 0,
      "description": "Liczba przypisanych kontakt\u00f3w"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Status paczki"
    }
  },
  "required": [
    "name"
  ]
}